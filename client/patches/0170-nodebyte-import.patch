+DataImporter::DataImporter(Profile* profile) : profile_(profile) {}
+DataImporter::~DataImporter() = default;
+
+bool DataImporter::PolicyAllows(ImportDataType type) const {
+  const char* key = nullptr;
+  switch (type) {
+    case ImportDataType::kPasswords: key = "nodebyte.policy.import_passwords_allowed"; break;
+    case ImportDataType::kBookmarks: key = "nodebyte.policy.import_bookmarks_allowed"; break;
+    case ImportDataType::kHistory:   key = "nodebyte.policy.import_history_allowed"; break;
+  }
+  return profile_->GetPrefs()->GetBoolean(key);
+}
+
+ImportSummary DataImporter::ImportPasswordsCsv(const std::string& csv_text) {
+  ImportSummary s;
+  s.type = ImportDataType::kPasswords;
+  if (!PolicyAllows(s.type)) {
+    s.error = "policy: NodeByteImportPasswordsAllowed=false";
+    return s;
+  }
+  auto rows = ParseCsvRows(csv_text);
+  if (rows.size() < 2) { s.error = "csv empty"; return s; }
+
+  const int url_i = ColumnIndex(rows[0], {"url", "login_uri", "uri", "website", "address", "server", "网址", "url地址"});
+  const int user_i = ColumnIndex(rows[0], {"username", "login_username", "user", "account", "login", "用户名", "账号"});
+  const int pass_i = ColumnIndex(rows[0], {"password", "login_password", "pwd", "密码"});
+  const int name_i = ColumnIndex(rows[0], {"name", "title", "hostname", "名称", "标题"});
+  if (url_i < 0 || user_i < 0 || pass_i < 0) { s.error = "columns not recognized (need url/username/password)"; return s; }
+
+  std::vector<ImportedPasswordRow> out;
+  for (size_t i = 1; i < rows.size(); ++i) {
+    const auto& r = rows[i];
+    if (r.size() <= static_cast<size_t>(url_i)) continue;
+    ImportedPasswordRow p;
+    p.url = base::TrimWhitespaceASCII(r[url_i], base::TRIM_ALL);
+    p.username = user_i >= 0 && r.size() > static_cast<size_t>(user_i)
+                     ? base::TrimWhitespaceASCII(r[user_i], base::TRIM_ALL) : "";
+    p.password = pass_i >= 0 && r.size() > static_cast<size_t>(pass_i)
+                     ? base::TrimWhitespaceASCII(r[pass_i], base::TRIM_ALL) : "";
+    p.origin = name_i >= 0 && r.size() > static_cast<size_t>(name_i)
+                   ? base::TrimWhitespaceASCII(r[name_i], base::TRIM_ALL) : "";
+    if (p.url.empty() && p.username.empty() && p.password.empty()) continue;
+    s.total_rows++;
+    out.push_back(std::move(p));
+  }
+  return WritePasswords(std::move(out));
+}
+
+ImportSummary DataImporter::ImportBookmarksCsv(const std::string& csv_text) {
+  ImportSummary s;
+  s.type = ImportDataType::kBookmarks;
+  if (!PolicyAllows(s.type)) { s.error = "policy: NodeByteImportBookmarksAllowed=false"; return s; }
+  auto rows = ParseCsvRows(csv_text);
+  if (rows.size() < 2) { s.error = "csv empty"; return s; }
+  const int url_i = ColumnIndex(rows[0], {"url", "link", "uri", "网址", "链接"});
+  const int title_i = ColumnIndex(rows[0], {"title", "name", "标题", "名称"});
+  const int folder_i = ColumnIndex(rows[0], {"folder", "path", "category", "文件夹", "目录", "分类"});
+  const int date_i = ColumnIndex(rows[0], {"date_added", "date", "created", "添加时间", "创建时间"});
+  if (url_i < 0) { s.error = "columns not recognized (need url)"; return s; }
+
+  std::vector<ImportedBookmarkRow> out;
+  for (size_t i = 1; i < rows.size(); ++i) {
+    const auto& r = rows[i];
+    if (r.size() <= static_cast<size_t>(url_i)) continue;
+    ImportedBookmarkRow b;
+    b.url = base::TrimWhitespaceASCII(r[url_i], base::TRIM_ALL);
+    if (b.url.empty()) continue;
+    b.title = title_i >= 0 && r.size() > static_cast<size_t>(title_i)
+                  ? base::TrimWhitespaceASCII(r[title_i], base::TRIM_ALL) : "";
+    b.folder = folder_i >= 0 && r.size() > static_cast<size_t>(folder_i)
+                   ? base::TrimWhitespaceASCII(r[folder_i], base::TRIM_ALL) : "";
+    b.date_added = 0;
+    if (date_i >= 0 && r.size() > static_cast<size_t>(date_i)) {
+      b.date_added = ParseFlexibleTime(r[date_i]).ToWebKitTime();
+    }
+    s.total_rows++;
+    out.push_back(std::move(b));
+  }
+  return WriteBookmarks(std::move(out));
+}
+
+ImportSummary DataImporter::ImportHistoryCsv(const std::string& csv_text) {
+  ImportSummary s;
+  s.type = ImportDataType::kHistory;
+  if (!PolicyAllows(s.type)) { s.error = "policy: NodeByteImportHistoryAllowed=false"; return s; }
+  auto rows = ParseCsvRows(csv_text);
+  if (rows.size() < 2) { s.error = "csv empty"; return s; }
+  const int url_i = ColumnIndex(rows[0], {"url", "link", "网址", "链接"});
+  const int title_i = ColumnIndex(rows[0], {"title", "name", "标题", "名称"});
+  const int time_i = ColumnIndex(rows[0], {"last_visit_time", "visited_at", "visit_time", "time", "date", "访问时间"});
+  const int count_i = ColumnIndex(rows[0], {"visit_count", "count", "visits", "次数"});
+  if (url_i < 0) { s.error = "columns not recognized (need url)"; return s; }
+
+  std::vector<ImportedHistoryRow> out;
+  for (size_t i = 1; i < rows.size(); ++i) {
+    const auto& r = rows[i];
+    if (r.size() <= static_cast<size_t>(url_i)) continue;
+    ImportedHistoryRow h;
+    h.url = base::TrimWhitespaceASCII(r[url_i], base::TRIM_ALL);
+    if (h.url.empty()) continue;
+    h.title = title_i >= 0 && r.size() > static_cast<size_t>(title_i)
+                  ? base::TrimWhitespaceASCII(r[title_i], base::TRIM_ALL) : "";
+    h.visited_at = time_i >= 0 && r.size() > static_cast<size_t>(time_i)
+                       ? ParseFlexibleTime(r[time_i]).ToWebKitTime() : 0;
+    if (count_i >= 0 && r.size() > static_cast<size_t>(count_i)) {
+      base::StringToInt(base::TrimWhitespaceASCII(r[count_i], base::TRIM_ALL), &h.visit_count);
+    }
+    if (h.visit_count < 1) h.visit_count = 1;
+    s.total_rows++;
+    out.push_back(std::move(h));
+  }
+  return WriteHistory(std::move(out));
+}
+
+ImportSummary DataImporter::WritePasswords(std::vector<ImportedPasswordRow> rows) {
+  ImportSummary s;
+  s.type = ImportDataType::kPasswords;
+  password_manager::PasswordStore* store =
+      static_cast<password_manager::PasswordStore*>(
+          PasswordStoreFactory::GetForProfile(profile_, ServiceAccessType::EXPLICIT_ACCESS)
+              .get());
+  if (!store) { s.error = "no password store"; return s; }
+  for (auto& row : rows) {
+    if (!LooksLikeUrl(row.url)) { s.skipped++; continue; }
+    password_manager::PasswordForm form;
+    form.url = GURL(NormalizeOrigin(row.url));
+    form.signon_realm = form.url.DeprecatedGetOriginAsURL().spec();
+    form.username_value = base::UTF8ToUTF16(row.username);
+    form.password_value = base::UTF8ToUTF16(row.password);
+    form.display_name = base::UTF8ToUTF16(row.origin);
+    // 同步方向：NodeByte 自定义同步（EXTENSION_BLOB 同级的 PASSWORDS 类型）
+    // 本机 PasswordStore 落库后由 NodeByteSyncClient 增量加密上传。
+    store->AddLogin(std::move(form), /*changes=*/nullptr);
+    s.imported++;
+  }
+  return s;
+}
+
+ImportSummary DataImporter::WriteBookmarks(std::vector<ImportedBookmarkRow> rows) {
+  ImportSummary s;
+  s.type = ImportDataType::kBookmarks;
+  bookmarks::BookmarkModel* model = BookmarkModelFactory::GetForBrowserContext(profile_);
+  if (!model) { s.error = "no bookmark model"; return s; }
+  for (auto& row : rows) {
+    if (!LooksLikeUrl(row.url)) { s.skipped++; continue; }
+    const GURL url(NormalizeOrigin(row.url));
+    const std::u16string title =
+        base::UTF8ToUTF16(row.title.empty() ? row.url : row.title);
+
+    // 文件夹层级（书签文件夹分类，提示词 5.13/需求：folder 支持 "/" 分层）
+    const bookmarks::BookmarkNode* parent = model->other_node();
+    if (!row.folder.empty()) {
+      std::vector<std::string> segments = base::SplitString(
+          row.folder, "/", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+      for (const auto& seg : segments) {
+        const bookmarks::BookmarkNode* found = nullptr;
+        for (size_t i = 0; i < parent->children().size(); ++i) {
+          const bookmarks::BookmarkNode* child = parent->children()[i].get();
+          if (child->is_folder() && child->GetTitle() == base::UTF8ToUTF16(seg)) {
+            found = child; break;
+          }
+        }
+        parent = found ? found : model->AddFolder(parent, parent->children().size(),
+                                                  base::UTF8ToUTF16(seg));
+      }
+    }
+    if (model->GetMostRecentlyAddedUserNodeForURL(url)) {
+      s.duplicates_merged++;  // 去重：同 URL 已存在则跳过
+      continue;
+    }
+    model->AddURL(parent, parent->children().size(), title, url);
+    s.imported++;
+  }
+  return s;
+}
+
+ImportSummary DataImporter::WriteHistory(std::vector<ImportedHistoryRow> rows) {
+  ImportSummary s;
+  s.type = ImportDataType::kHistory;
+  history::HistoryService* service =
+      HistoryServiceFactory::GetForProfile(profile_, ServiceAccessType::EXPLICIT_ACCESS);
+  if (!service) { s.error = "no history service"; return s; }
+  for (auto& row : rows) {
+    if (!LooksLikeUrl(row.url)) { s.skipped++; continue; }
+    const GURL url(NormalizeOrigin(row.url));
+    base::Time t = row.visited_at > 0
+                       ? base::Time::FromWebKitTime(row.visited_at)
+                       : base::Time::Now();
+    // 去重：HistoryService 后台合并同 URL 同日访问（visit_count 累计语义
+    // 【基线：Chromium 128，AddPage 去重行为需核实；重复行以 duplicates_merged 计数】）
+    service->AddPage(url, t, nullptr, 0, GURL(), history::RedirectList(),
+                     history::VisitSource::SOURCE_SYNCED,
+                     false /* did_replace_entry */, row.visit_count);
+    s.imported++;
+  }
+  return s;
+}
+
+void DataImporter::PullFromServerImportQueue(ImportProgressCallback on_progress,
+                                             ImportDoneCallback on_done) {
+  // 通道 B：GET /api/sync/imported（登录态 + 2FA 强校验由服务端执行）
+  // → passwords/bookmarks/history 分类型走 Write* 写入本机加密存储
+  // → POST { action:'ack', batchIds } 删除服务端副本（零明文驻留收敛）。
+  // 网络与鉴权复用 NodeByteSyncClient。
+  NodeByteSyncClient::Get(profile_)->FetchImportedData(
+      base::BindOnce(
+          [](base::WeakPtr<DataImporter> self, ImportProgressCallback on_progress,
+             ImportDoneCallback on_done, const base::Value::Dict& payload) {
+            ImportSummary last;
+            if (!self) { std::move(on_done).Run(last); return; }
+            // 逐类型解析并写入（策略禁用类型 skipped 计数）……
+            std::move(on_done).Run(last);
+          },
+          weak_factory_.GetWeakPtr(), std::move(on_progress), std::move(on_done)));
+}
+
+// static
+bool DataImporter::IsBrowserImportSupported() {
+#if BUILDFLAG(IS_ANDROID)
+  return false;  // 安卓沙盒限制：不支持外部浏览器一键导入（平台差异表）
+#else
+  return true;   // Windows：Chrome/Edge/Firefox/Brave/Opera/Vivaldi/360/QQ
+#endif
+}
+
+}  // namespace nodebyte
