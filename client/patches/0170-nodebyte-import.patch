+// ---- 极简 RFC-4180 解析（与服务端 csv.ts 同源）----
+std::vector<std::vector<std::string>> ParseCsvRows(const std::string& text) {
+  std::string t = text;
+  if (!t.empty() && static_cast<unsigned char>(t[0]) == 0xEF) {
+    // UTF-8 BOM (EF BB BF)
+    if (t.size() >= 3 && static_cast<unsigned char>(t[1]) == 0xBB &&
+        static_cast<unsigned char>(t[2]) == 0xBF) {
+      t = t.substr(3);
+    }
+  }
+  std::vector<std::vector<std::string>> rows;
+  std::vector<std::string> row;
+  std::string field;
+  bool in_quotes = false;
+  for (size_t i = 0; i < t.size(); ++i) {
+    const char ch = t[i];
+    if (in_quotes) {
+      if (ch == '"') {
+        if (i + 1 < t.size() && t[i + 1] == '"') { field += '"'; ++i; continue; }
+        in_quotes = false;
+        continue;
+      }
+      field += ch;
+      continue;
+    }
+    if (ch == '"') { in_quotes = true; continue; }
+    if (ch == ',') { row.push_back(field); field.clear(); continue; }
+    if (ch == '\r') continue;
+    if (ch == '\n') { row.push_back(field); rows.push_back(row); row.clear(); field.clear(); continue; }
+    field += ch;
+  }
+  if (!row.empty() || !field.empty()) { row.push_back(field); rows.push_back(row); }
+  return rows;
+}
+
+int ColumnIndex(const std::vector<std::string>& header,
+                const std::vector<std::string>& aliases) {
+  for (const std::string& alias : aliases) {
+    for (size_t i = 0; i < header.size(); ++i) {
+      if (base::ToLowerASCII(base::TrimWhitespaceASCII(header[i], base::TRIM_ALL)) == alias) {
+        return static_cast<int>(i);
+      }
+    }
+  }
+  return -1;
+}
+
+base::Time ParseFlexibleTime(const std::string& s) {
+  std::string v = base::TrimWhitespaceASCII(s, base::TRIM_ALL);
+  if (v.empty()) return base::Time();
+  int64_t n = 0;
+  if (base::StringToInt64(v, &n)) {
+    if (n > 100000000000000LL) return base::Time::FromWebKitTime(n);   // 微秒
+    if (n > 1000000000LL) return base::Time::FromSecondsSinceUnixEpoch(
+        static_cast<double>(n));
+    return base::Time();
+  }
+  base::Time out;
+  if (base::Time::FromString(v.c_str(), &out)) return out;
+  return base::Time();
+}
+
+bool LooksLikeUrl(const std::string& s) {
+  std::string v = base::TrimWhitespaceASCII(s, base::TRIM_ALL);
+  if (v.empty()) return false;
+  if (base::StartsWith(v, "http://", base::CompareCase::INSENSITIVE_ASCII) ||
+      base::StartsWith(v, "https://", base::CompareCase::INSENSITIVE_ASCII)) return true;
+  return v.find('.') != std::string::npos;
+}
+
+std::string NormalizeOrigin(const std::string& url) {
+  GURL g(url.find("://") == std::string::npos ? "https://" + url : url);
+  return g.IsValid() ? g.spec() : url;
+}
+
+}  // namespace
