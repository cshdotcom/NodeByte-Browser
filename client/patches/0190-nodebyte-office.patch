@@ -0,0 +1,20 @@
+// Copyright 2026 The NodeByte Browser Authors. BSD-3-Clause.
+//
+// 高级打印面板入口开关（提示词 5.11.2/5.11.3；hook 0240 的 Print() 重定向读取）。
+//   1) 指令强制值 prefs "nodebyte.directive.forced.NodeBytePrintPanelEnabled"
+//   2) 编译默认 true（面板为主；关闭/撤销即回退原生打印预览，运行时可切换）
+
+#ifndef CHROME_BROWSER_NODEBYTE_PRINT_PRINT_PANEL_H_
+#define CHROME_BROWSER_NODEBYTE_PRINT_PRINT_PANEL_H_
+
+class Profile;
+
+namespace nodebyte {
+
+// NodeBytePrintPanelEnabled：true → 打印入口打开 nodebyte://print 面板；
+// false → 原生打印预览（策略/指令通道可运行时切换，无需重编译）。
+bool PrintPanelEnabled(Profile* profile);
+
+}  // namespace nodebyte
+
+#endif  // CHROME_BROWSER_NODEBYTE_PRINT_PRINT_PANEL_H_
diff --git a/chrome/browser/resources/nodebyte/BUILD.gn b/chrome/browser/resources/nodebyte/BUILD.gn
new file mode 100644
--- /dev/null
+++ b/chrome/browser/resources/nodebyte/BUILD.gn
@@ -0,0 +1,14 @@
+# Copyright 2026 The NodeByte Browser Authors. BSD-3-Clause.
+#
+# NodeByte 独立资源 grd 的 gn 目标（资源隔离铁律）。
+# 由 hook 0230（chrome/browser/BUILD.gn）与 hook 0240 引用：
+#   "//chrome/browser/resources/nodebyte:nodebyte_resources"
+
+import("//tools/grit/grit_rule.gni")
+
+grit("nodebyte_resources") {
+  source = "nodebyte_resources.grd"
+  # 不传 defines：grd 无条件编译分支（build_flag_defines 并非全局变量，gn gen 会报 Undefined identifier）
+  use_qualified_include = false
+  output_dir = "$root_gen_dir/chrome/browser/resources/nodebyte"
+}
diff --git a/chrome/browser/resources/nodebyte/README.md b/chrome/browser/resources/nodebyte/README.md
new file mode 100644
--- /dev/null
+++ b/chrome/browser/resources/nodebyte/README.md
@@ -0,0 +1,23 @@
+# NodeByte 独立资源包（grd）树内文件映射
+
+构建前把本仓库 `client/webui/` 的页面源码复制进 Chromium 树
+`chrome/browser/resources/nodebyte/`（grd 引用相对路径）。
+复制脚本：`bash scripts/sync_webui.sh /path/to/chromium/src`（构建机执行）。
+
+| 树内文件 | 仓库来源 | 用途 |
+|---|---|---|
+| `login/{index.html,app.js,style.css,i18n.js}` | `client/webui/login/` | nodebyte://login（5.1） |
+| `drop/{index.html,app.js,style.css,i18n.js}` | `client/webui/drop/` | nodebyte://drop（5.4/5.5） |
+| `settings/index.html` | `client/webui/settings/` | nodebyte://settings（5.3/5.14） |
+| `translate/{index.html,app.js}` | `client/webui/translate/` | nodebyte://translate |
+| `offline-game/{index.html,game.js}` | `client/webui/offline-game/` | nodebyte://game + 断网错误页（5.12） |
+| `usercenter/index.html` | `client/webui/usercenter/` | nodebyte://usercenter 跳转占位 |
+| `office/{index.html,app.js}` | `client/webui/office/` | nodebyte://office（5.11.1，v1.4.4） |
+| `print/{index.html,app.js,pdf-kit.js}` | `client/webui/print/` | nodebyte://print（5.11.2/3，v1.4.4） |
+| `nodebyte_resources.grd` / `BUILD.gn` | 本目录直接维护 | grit 定义与目标 |
+
+注意：
+- `IDR_NODEBYTE_*` 常量由 grit 生成到 `grit/nodebyte_resources.h`，
+  控制器（chrome/browser/ui/webui/nodebyte/）include 该生成头。
+- translate/app.js 若尚未存在则以 index.html 内联脚本为准（grd 仅登记存在的文件）。
+- usercenter/index.html 为占位跳转页（在线个人中心，v1.4.x 交付语义）。
diff --git a/chrome/browser/resources/nodebyte/nodebyte_resources.grd b/chrome/browser/resources/nodebyte/nodebyte_resources.grd
new file mode 100644
--- /dev/null
+++ b/chrome/browser/resources/nodebyte/nodebyte_resources.grd
@@ -0,0 +1,46 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<!--
+  NodeByte Browser 独立资源 grd（资源隔离铁律：离线游戏、办公套件、打印面板、
+  全部 nodebyte:// 页面静态资源独立成包，内核升级几乎不冲突；提示词 4.2/5.11/5.12）。
+
+  树内路径：chrome/browser/resources/nodebyte/（源文件从仓库 client/webui/ 复制，
+  见同目录 README.md 的映射表；BUILD.gn 目标 //chrome/browser/resources/nodebyte:nodebyte_resources
+  由 hook 0230/0240 引用）。
+-->
+<grit latest_public_release="0" current_release="1" output_all_resource_defines="false">
+  <outputs>
+    <output filename="grit/nodebyte_resources.h" type="rc_header"/>
+    <output filename="nodebyte_resources.pak" type="data_package"/>
+  </outputs>
+  <release seq="1">
+    <includes>
+      <!-- nodebyte://login（提示词 5.1） -->
+      <include name="IDR_NODEBYTE_LOGIN_INDEX" file="login/index.html" type="BINDATA"/>
+      <include name="IDR_NODEBYTE_LOGIN_APP" file="login/app.js" type="BINDATA"/>
+      <include name="IDR_NODEBYTE_LOGIN_STYLE" file="login/style.css" type="BINDATA"/>
+      <include name="IDR_NODEBYTE_LOGIN_I18N" file="login/i18n.js" type="BINDATA"/>
+      <!-- nodebyte://drop（提示词 5.4/5.5） -->
+      <include name="IDR_NODEBYTE_DROP_INDEX" file="drop/index.html" type="BINDATA"/>
+      <include name="IDR_NODEBYTE_DROP_APP" file="drop/app.js" type="BINDATA"/>
+      <include name="IDR_NODEBYTE_DROP_STYLE" file="drop/style.css" type="BINDATA"/>
+      <include name="IDR_NODEBYTE_DROP_I18N" file="drop/i18n.js" type="BINDATA"/>
+      <!-- nodebyte://settings（提示词 5.3/5.14） -->
+      <include name="IDR_NODEBYTE_SETTINGS_INDEX" file="settings/index.html" type="BINDATA"/>
+      <!-- nodebyte://translate（翻译面板） -->
+      <include name="IDR_NODEBYTE_TRANSLATE_INDEX" file="translate/index.html" type="BINDATA"/>
+      <include name="IDR_NODEBYTE_TRANSLATE_APP" file="translate/app.js" type="BINDATA"/>
+      <!-- nodebyte://game（离线小游戏，提示词 5.12） -->
+      <include name="IDR_NODEBYTE_GAME_INDEX" file="offline-game/index.html" type="BINDATA"/>
+      <include name="IDR_NODEBYTE_GAME_APP" file="offline-game/game.js" type="BINDATA"/>
+      <!-- nodebyte://usercenter 占位（在线个人中心跳转页） -->
+      <include name="IDR_NODEBYTE_USERCENTER_INDEX" file="usercenter/index.html" type="BINDATA"/>
+      <!-- nodebyte://office（办公套件，提示词 5.11.1；v1.4.4） -->
+      <include name="IDR_NODEBYTE_OFFICE_INDEX" file="office/index.html" type="BINDATA"/>
+      <include name="IDR_NODEBYTE_OFFICE_APP" file="office/app.js" type="BINDATA"/>
+      <!-- nodebyte://print（高级打印面板，提示词 5.11.2/5.11.3；v1.4.4） -->
+      <include name="IDR_NODEBYTE_PRINT_INDEX" file="print/index.html" type="BINDATA"/>
+      <include name="IDR_NODEBYTE_PRINT_APP" file="print/app.js" type="BINDATA"/>
+      <include name="IDR_NODEBYTE_PRINT_PDF_KIT" file="print/pdf-kit.js" type="BINDATA"/>
+    </includes>
+  </release>
+</grit>
