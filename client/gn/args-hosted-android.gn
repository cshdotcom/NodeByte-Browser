# ---- out/Release-hosted-android/args.gn —— GitHub 托管 Runner 直编（Android arm64）----
# ubuntu-22.04 托管 Runner + target_os=android（SDK/NDK 由 gclient hooks 自动下载）。
# 产物：chrome_public_apk（is_official_build=false 时自动 debug 签名，可直接侧载安装）。

is_debug = false
is_component_build = false
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0
use_thin_lto = false                 # Android LTO 更吃资源；托管禁用
is_official_build = false
dcheck_always_on = false

enable_nacl = false
enable_widevine = false
proprietary_codecs = false
ffmpeg_branding = "Chromium"

google_api_key = ""
google_default_client_id = ""
google_default_client_secret = ""
disable_fieldtrial_config = true

# Android 目标
target_os = "android"
target_cpu = "arm64"

# 应用包名（branding patch 0100 同时改 Java 包资源；需核实 build/config/android 内部规则）
# chrome_public_manifest_package = "cn.nodebyte.browser"
