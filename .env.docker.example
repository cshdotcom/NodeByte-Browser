# =====================================================================
# NodeByte Server All-in-One 镜像 —— docker run 环境变量参考
# 用法：cp .env.docker.example .env 修改后
#   docker run -d --name nodebyte --env-file .env -p 8080:8080 \
#     -v nodebyte-data:/data ghcr.io/cshdotcom/nodebyte-server:latest
# 说明：所有 *_SECRET/PASSWORD 留空时，首次启动自动生成强随机值
#       并持久化到 /data/secrets/（重启复用，升级不丢）。
# =====================================================================

# ---------- 入口 ----------
# 对外端口由 docker -p 映射控制（容器内固定 8080 入口 / 3000 Web）
# 例：-p 9000:8080   →   浏览器访问 http://host:9000
# 时区
TZ=Asia/Shanghai

# ---------- 安全密钥（生产必填强随机值；留空自动生成） ----------
JWT_SECRET=
INTERNAL_SHARED_SECRET=
DATABASE_PASSWORD=

# ---------- 对象存储（内嵌 RustFS，S3 兼容；应用端走 minio SDK） ----------
MINIO_ROOT_USER=nodebyte
MINIO_ROOT_PASSWORD=

# 远程访问 Drop 直传/直下时的对外主机与端口：
#   本机访问保持默认（127.0.0.1:9000 签名 URL 走 8080 反代同理）
#   反代/公网部署示例：MINIO_ENDPOINT=your.domain.com  MINIO_PORT=8443  MINIO_USE_SSL=true
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false

# ---------- 管理员（首次启动生效，脚本幂等） ----------
ADMIN_EMAIL=admin@nodebyte.cn
ADMIN_PASSWORD=admin12345

# ---------- 站点 ----------
# 对外基础地址（生成分享/邀请链接）
PUBLIC_BASE_URL=http://localhost:8080
# 默认同步服务器域名（客户端「同步服务器地址」缺省值）
DEFAULT_SYNC_DOMAIN=bsync.nodebyte.cn
# 默认用户云盘配额（MB）
DEFAULT_QUOTA_MB=10240

# ---------- SMTP（自助注册 / 忘记密码方式 B；留空 = 仅管理员开号） ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@nodebyte.cn
