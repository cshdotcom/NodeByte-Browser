# ===== NodeByte Server 环境变量（.env）=====
# 数据库（PostgreSQL）
DATABASE_URL=postgres://nodebyte:nodebyte@localhost:5432/nodebyte

# JWT 密钥（生产环境务必更换为强随机值，>=32 字符）
JWT_SECRET=change-me-to-a-long-random-secret-value

# 内部服务共享密钥（Next.js -> ws-service 推送事件）
INTERNAL_SHARED_SECRET=change-me-internal-secret

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_DROP=drop-files
MINIO_BUCKET_SHOTS=screenshots
MINIO_BUCKET_SYNC=sync-blobs
MINIO_BUCKET_EXT=extension-pool
MINIO_BUCKET_DOCS=doc-snapshots
MINIO_BUCKET_REC=recordings
MINIO_BUCKET_AVATAR=avatars

# 对外基础地址（生成预签名 URL 使用）
PUBLIC_BASE_URL=http://localhost:3000

# SMTP（自助注册 / 忘记密码方式 B）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@nodebyte.cn

# 站点
DEFAULT_SYNC_DOMAIN=bsync.nodebyte.cn
DEFAULT_QUOTA_MB=10240
NEXT_PUBLIC_DEFAULT_DOMAIN=bsync.nodebyte.cn
